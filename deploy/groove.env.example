# GrooveGoblin — ambiente do serviço systemd (arquivo PRIVADO, fora do repositório).
#
# Este exemplo é só um molde com valores fictícios. Copie para
# /etc/groovegoblin/groove.env, troque os valores pelos seus e proteja:
#
#   sudo install -d -m 0755 /etc/groovegoblin
#   sudo install -m 0600 -o root -g root deploy/groove.env.example /etc/groovegoblin/groove.env
#   sudo editor /etc/groovegoblin/groove.env
#
# O systemd lê este arquivo como root ANTES de baixar privilégios, então 0600
# root:root funciona. O `deploy/install.sh` recusa arquivo que não seja do root
# ou que tenha permissão de escrita para o grupo/outros, e recusa qualquer
# caminho dentro do checkout.
#
# Formato: uma CHAVE=valor por linha, `#` para comentar. Não use `export`, `$VAR`,
# expansão de shell, continuação de linha nem chave desconhecida: o systemd lê
# este arquivo como EnvironmentFile e os scripts de deploy o leem linha a linha,
# sem nunca executá-lo como shell. Valores fictícios como os deste modelo são
# recusados pelo instalador.

# --- Servidor -----------------------------------------------------------------
# Porta interna, só em loopback. O HTTPS da tailnet é publicado pelo `tailscale
# serve` apontando para este endereço; nunca abra esta porta fora do loopback.
PORT=5173
GROOVE_HOST=127.0.0.1

# Site construído: o install.sh roda `npm run build` e o servidor publica dist/.
STATIC_ROOT=dist

# Diretório de dados: fora do repositório, dono = usuário do serviço, modo 0700.
GROOVE_DATA_DIR=/var/lib/groovegoblin

# tailscale = produção (exige identidade do Serve e lista de logins).
# dev = só loopback, sem identidade: use apenas para testes locais na própria máquina.
GROOVE_AUTH=tailscale
GROOVE_ALLOWED_LOGINS=usuario@example.org

# Origem pública canônica, exatamente como aparece na barra do navegador:
# https://<máquina>.<tailnet>.ts.net (sem barra no fim, sem caminho, sem porta 443).
GROOVE_PUBLIC_ORIGIN=https://groove.exemplo.ts.net

# --- Limites e rotação (opcionais; estes são os padrões do servidor) ----------
# Teto por blob, em bytes (padrão 209715200 = 200 MiB).
GROOVE_MAX_BLOB_BYTES=209715200
# Reserva de disco livre; gravação que a violaria responde 507 (padrão 134217728 = 128 MiB).
GROOVE_MIN_FREE_BYTES=134217728
# Instantâneos diários mantidos (1..60, padrão 14).
GROOVE_BACKUP_KEEP=14

# Limites de material POR CURSO (opcionais; exemplos comentados = padrões).
# Alternativa sem alterar este ambiente: <dataDir>/intake-limits.json, objeto
# JSON com maxEntries, maxZipBytes, maxZipPdfMembers, maxZipPdfBytes e/ou
# maxCourseBytes. Precedência: padrões < arquivo privado < ambiente.
# São lidos na subida; reinicie apenas groovegoblin após ajustar.
# Não alteram tetos de requisição/blob nem proteções de cada membro de ZIP.
# GROOVE_INTAKE_MAX_ENTRIES=300
# GROOVE_INTAKE_MAX_ZIP_BYTES=67108864
# GROOVE_INTAKE_MAX_ZIP_PDF_MEMBERS=60
# GROOVE_INTAKE_MAX_ZIP_PDF_BYTES=268435456
# GROOVE_INTAKE_MAX_COURSE_BYTES=3221225472
