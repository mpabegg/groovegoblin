# GrooveGoblin — serviço pessoal para Raspberry Pi (ou qualquer Linux com systemd).
#
# O deploy/install.sh copia este arquivo para
# /etc/systemd/system/groovegoblin.service e substitui as linhas de
# usuário/caminho/Node apenas quando você passa --app-dir, --data-dir, --user ou
# quando o `node` não está em /usr/bin/node. Sem argumentos, o que está aqui é o
# que vai para o systemd, com os padrões:
#
#   usuário   groovegoblin
#   código    /opt/groovegoblin          (o checkout do repositório)
#   dados     /var/lib/groovegoblin      (fora do checkout; dono = usuário, modo 0700)
#   ambiente  /etc/groovegoblin/groove.env  (privado, fora do checkout, modo 0600)
#
# O Node escuta SÓ em 127.0.0.1 — isso vem do ambiente (GROOVE_HOST=127.0.0.1) e é
# obrigatório: o servidor recusa subir em qualquer outra interface. O HTTPS dentro
# da tailnet é publicado pelo `tailscale serve`, nunca por um bind público.

[Unit]
Description=GrooveGoblin (servidor pessoal de prática musical)
Documentation=file:/opt/groovegoblin/deploy/README.md
After=local-fs.target
Wants=local-fs.target

[Service]
Type=simple
User=groovegoblin
Group=groovegoblin
WorkingDirectory=/opt/groovegoblin
EnvironmentFile=/etc/groovegoblin/groove.env
Environment=HOME=/var/lib/groovegoblin
ExecStart=/usr/bin/node server.js
Restart=on-failure
RestartSec=3
TimeoutStopSec=20
KillSignal=SIGTERM
SyslogIdentifier=groovegoblin

# Limites: uploads e backups passam por streaming, então a memória fica estável
# por mais que o arquivo seja grande. Ajuste MemoryMax se um dia o conjunto de
# documentos crescer muito (o instantâneo é montado em memória antes de gravar).
MemoryHigh=384M
MemoryMax=768M
CPUQuota=150%
TasksMax=256
LimitNOFILE=4096
UMask=0077

# Isolamento: só o diretório de dados é gravável; o resto do sistema é somente
# leitura, o /tmp é privado do serviço e não há privilégio nenhum a ganhar.
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/lib/groovegoblin
ProtectProc=invisible
ProcSubset=pid
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RemoveIPC=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=
AmbientCapabilities=
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
# Se o serviço não subir por causa do filtro de syscalls (linhas "EPERM" no
# journal), apague só a linha `SystemCallFilter=@system-service` acima e mantenha
# todo o resto do isolamento.
# MemoryDenyWriteExecute NÃO entra: o motor JavaScript do Node precisa de memória
# executável gravável e o serviço não subiria.

[Install]
WantedBy=multi-user.target
